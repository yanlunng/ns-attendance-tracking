<%- include('partials/header') %>
<div class="page-head">
  <h1>Attendance Summary</h1>
  <form method="get" action="/summary" class="date-picker">
    <label>Date <input type="date" name="date" value="<%= summary.date %>" max="<%= todayStr %>" onchange="this.form.submit()" /></label>
  </form>
</div>

<div class="stats">
  <div class="stat"><span><%= summary.stats.reported %>/<%= summary.stats.total %></span>reported</div>
  <div class="stat"><span><%= summary.stats.present %></span>present</div>
  <div class="stat"><span><%= summary.stats.off %></span>off</div>
  <div class="stat"><span><%= summary.stats.leave %></span>leave</div>
  <div class="stat <%= summary.stats.conflicts > 0 ? 'stat-warn' : '' %>"><span><%= summary.stats.conflicts %></span>conflicts</div>
</div>

<p><a href="/export?date=<%= summary.date %>">Download this summary as Excel</a></p>

<table class="attendance-table">
  <thead>
    <tr>
      <th>Name</th>
      <th>ID</th>
      <th>Unit</th>
      <th>Merged Status</th>
      <th>Submitted by</th>
    </tr>
  </thead>
  <tbody>
    <% summary.rows.forEach(row => { %>
    <tr class="<%= row.conflict ? 'row-conflict' : row.unreported ? 'row-unreported' : '' %>">
      <td><%= row.person.name %></td>
      <td><%= row.person.ref_id || '' %></td>
      <td><%= row.person.unit || '' %></td>
      <td>
        <% if (row.unreported) { %>
          <span class="badge badge-warn">Not reported</span>
        <% } else if (row.conflict) { %>
          <span class="badge badge-danger">Conflict</span>
        <% } else { %>
          <span class="badge badge-<%= row.status %>"><%= row.status %></span>
        <% } %>
      </td>
      <td>
        <% row.submissions.forEach(s => { %>
          <div class="submitter-line"><%= s.username %>: <strong><%= s.status %></strong><% if (s.remarks) { %> — <%= s.remarks %><% } %></div>
        <% }) %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<%- include('partials/footer') %>
