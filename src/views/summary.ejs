<%- include('partials/header') %>
<div class="page-head">
  <h1>Attendance Summary</h1>
  <form method="get" action="/summary" class="date-picker">
    <label>Date <input type="date" name="date" value="<%= date %>" min="<%= cycle.start || '' %>" max="<%= cycle.end || '' %>" onchange="this.form.submit()" /></label>
  </form>
</div>

<% if (weekendBlocked) { %>
  <p class="banner-warn">
    <%= date %> is a weekend — no attendance was expected, so there's nothing to summarize. An
    admin can turn on "Count weekends as working days" on the Roster page if this cycle needs
    weekend tracking.
  </p>
<% } else { %>

<% if (phaseStagger) { %>
  <p class="hint">
    <%= phaseStagger.excludedCount %> Main Body personnel aren't in the total strength yet — they
    join starting <%= phaseStagger.mainBodyStart %> (Commander Phase only until then).
  </p>
<% } %>

<div class="upload-box">
  <h2>Parade state confirmation
    <% if (confirmation.fullyConfirmed) { %><span class="badge badge-present">✅ Confirmed</span><% } %>
  </h2>
  <p class="hint">
    Confirming a line marks anyone in it with nothing reported yet as Present (approved). Each line
    can only be confirmed by the KAH whose scope covers it; BC/BSM/B2IC can confirm any line.
  </p>
  <table class="attendance-table">
    <thead><tr><th>Line</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% confirmation.lines.forEach(l => { %>
      <tr>
        <td data-label="Line"><%= l.label %></td>
        <td data-label="Status"><%= l.confirmed ? '✅ Confirmed' : '⬜ Not confirmed' %></td>
        <td>
          <% if (!l.confirmed && l.canConfirm) { %>
          <form method="post" action="/summary/confirm-line" class="inline">
            <input type="hidden" name="date" value="<%= date %>" />
            <input type="hidden" name="line" value="<%= l.key %>" />
            <button type="submit">Confirm</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (confirmation.canConfirmAll && !confirmation.fullyConfirmed) { %>
  <form method="post" action="/summary/confirm-all">
    <input type="hidden" name="date" value="<%= date %>" />
    <button type="submit">Confirm ALL lines</button>
  </form>
  <% } %>
</div>

<div class="stats">
  <div class="stat"><span><%= summary.stats.reported %>/<%= summary.stats.total %></span>reported</div>
  <div class="stat"><span><%= summary.stats.present %></span>present</div>
  <div class="stat"><span><%= summary.stats.offApproved %></span>off (approved)</div>
  <div class="stat <%= summary.stats.offPending > 0 ? 'stat-warn' : '' %>"><span><%= summary.stats.offPending %></span>off (pending)</div>
  <div class="stat"><span><%= summary.stats.mc %></span>mc</div>
  <div class="stat"><span><%= summary.stats.outproApproved %></span>outpro (approved)</div>
  <div class="stat <%= summary.stats.outproPending > 0 ? 'stat-warn' : '' %>"><span><%= summary.stats.outproPending %></span>outpro (pending)</div>
  <div class="stat <%= summary.stats.conflicts > 0 ? 'stat-warn' : '' %>"><span><%= summary.stats.conflicts %></span>conflicts</div>
</div>

<p>
  <a href="/export?date=<%= date %>">Download this summary as Excel</a>
  <% if (isAdmin && (summary.stats.offPending > 0 || summary.stats.outproPending > 0)) { %> · <a href="/approvals">Review pending approvals</a><% } %>
</p>

<table class="attendance-table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Rank</th>
      <th>Unit</th>
      <th>Merged Status</th>
      <th>Submitted by</th>
    </tr>
  </thead>
  <tbody>
    <% summary.rows.forEach(row => { %>
    <tr class="<%= row.conflict ? 'row-conflict' : row.unreported ? 'row-unreported' : '' %>">
      <td data-label="Name"><%= row.person.name %></td>
      <td data-label="Rank"><%= row.person.ref_id || '' %></td>
      <td data-label="Unit"><%= row.person.unit || '' %></td>
      <td data-label="Merged Status">
        <% if (row.unreported) { %>
          <span class="badge badge-warn">Not reported</span>
        <% } else if (row.conflict) { %>
          <span class="badge badge-danger">Conflict</span>
        <% } else if (row.status === 'off') { %>
          <span class="badge badge-off">Off (<%= formatOffPeriod(row.offPeriod, row.offTime, row.offTimeEnd) %>)</span>
          <span class="badge <%= row.approvalState === 'approved' ? 'badge-present' : 'badge-warn' %>"><%= row.approvalState %></span>
        <% } else if (row.status === 'mc') { %>
          <span class="badge badge-mc">MC</span>
          <% if (row.missingAttachment) { %>
            <span class="badge badge-warn">Missing attachment</span>
            <form method="post" action="/attendance/submission/<%= row.mcSubmissionId %>/attachment" enctype="multipart/form-data" class="attachment-form">
              <input type="hidden" name="returnDate" value="<%= date %>" />
              <input type="file" name="attachment" required />
              <button type="submit">Attach</button>
            </form>
          <% } else { %>
            <a href="/attendance/attachment/<%= row.mcSubmissionId %>">View attachment</a>
          <% } %>
        <% } else if (row.status === 'outpro') { %>
          <span class="badge badge-outpro">1st Day Outpro</span>
          <span class="badge <%= row.approvalState === 'approved' ? 'badge-present' : 'badge-warn' %>"><%= row.approvalState %></span>
        <% } else { %>
          <span class="badge badge-<%= row.status %>"><%= row.status %></span>
        <% } %>
      </td>
      <td data-label="Submitted by">
        <% row.submissions.forEach(s => { %>
          <div class="submitter-line">
            <%= s.username %>:
            <strong><%= s.status %><% if (s.status === 'off') { %> (<%= formatOffPeriod(s.off_period, s.off_time, s.off_time_end) %>)<% } %></strong>
            <% if (s.status === 'off' || s.status === 'outpro') { %>· <%= s.approval_status %><% } %>
            <% if (s.remarks) { %> — <%= s.remarks %><% } %>
          </div>
        <% }) %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>
<%- include('partials/footer') %>
