<%- include('partials/header') %>
<div class="page-head">
  <h1>Outfield Designation</h1>
  <a href="/outfield?group=<%= group %>" class="button-link">Refresh</a>
</div>
<script>
  // Auto-refresh when returning to this tab after being away for a bit —
  // e.g. cancelling someone's ICT on the Roster page, then switching back
  // here. Only fires after a real away period (not a quick focus flicker),
  // so it never interrupts an in-progress drag.
  (function () {
    var hiddenAt = null;
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') {
        hiddenAt = Date.now();
      } else if (document.visibilityState === 'visible' && hiddenAt && Date.now() - hiddenAt > 5000) {
        window.location.reload();
      }
    });
  })();
</script>

<div class="tab-bar">
  <% groups.forEach(g => { %>
    <a href="/outfield?group=<%= g %>" class="tab <%= g === group ? 'tab-active' : '' %>"><%= g %></a>
  <% }) %>
</div>

<% if (importError) { %><p class="error"><%= importError %></p><% } %>

<details class="outfield-template-box">
  <summary>Export / import a template (RBS, FP, PSTAR slot assignments)</summary>
  <p class="hint">
    Export saves everyone's current slot as an Excel file. Importing it later (e.g. for a new
    cycle) fills in matching people by name + date of birth wherever they're still eligible and
    the slot is empty — it never overwrites an occupied slot or moves someone already placed
    elsewhere, and anyone who's left/changed group is simply skipped.
  </p>
  <a href="/outfield/export" class="button-link">Export current designation</a>
  <% if (canEdit) { %>
  <form method="post" action="/outfield/import" enctype="multipart/form-data" class="inline">
    <input type="file" name="file" accept=".xlsx" required />
    <button type="submit">Import template</button>
  </form>
  <% } %>
</details>

<% if (group === 'KAH') { %>
  <p class="hint">
    Named leadership appointments (e.g. Battery Commander) that don't fit a Fire Unit role — this
    group rarely needs full Outfield Designation, so add only the specific people/roles that
    actually matter. Search picks from the whole roster, not just KAH — e.g. someone classified
    RBS can be designated BC here, which pulls them out of their RBS slot/pool (they reappear
    there, unassigned, if the KAH designation is later removed).
  </p>
  <% if (kahError) { %><p class="error"><%= kahError %></p><% } %>

  <table class="attendance-table">
    <thead><tr><th>Name</th><th>Rank</th><th>Role</th><th></th></tr></thead>
    <tbody>
      <% kahDesignations.forEach(d => { %>
      <tr>
        <td data-label="Name"><%= d.name %></td>
        <td data-label="Rank"><%= d.ref_id || '' %></td>
        <td data-label="Role"><%= d.role_text %></td>
        <td>
          <% if (canEdit) { %>
          <form method="post" action="/outfield/kah/<%= d.id %>/remove" class="inline">
            <button type="submit" class="link-btn">Remove</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (kahDesignations.length === 0) { %><p class="empty">Nobody designated yet.</p><% } %>

  <% if (canEdit) { %>
  <div class="add-exception">
    <form method="post" action="/outfield/kah/add" id="kah-add-form">
      <div class="search-wrap">
        <label>Person <input type="text" id="kah-search-input" placeholder="Type a name…" autocomplete="off" /></label>
        <input type="hidden" name="rosterId" id="kah-selected-roster-id" />
        <div id="kah-search-results" class="search-results"></div>
      </div>
      <label>Role <input type="text" name="roleText" placeholder="e.g. BC" required /></label>
      <button type="submit">Add</button>
    </form>
  </div>
  <script>
    window.FULL_ROSTER = <%- JSON.stringify(fullRoster.map(p => ({ id: p.id, name: p.name, ref_id: p.ref_id || '' }))) %>;
  </script>
  <script src="/outfield-kah.js"></script>
  <% } %>

<% } else { %>
<% const showEquipment = view === 'equipment' && !!equipmentBoard; %>

<% if (equipmentBoard) { %>
<div class="tab-bar sub-tab-bar">
  <a href="/outfield?group=<%= group %>" class="tab <%= !showEquipment ? 'tab-active' : '' %>">Crew</a>
  <a href="/outfield?group=<%= group %>&view=equipment" class="tab <%= showEquipment ? 'tab-active' : '' %>">Equipment</a>
</div>
<% } %>

<% if (showEquipment) { %>
<% if (equipError) { %><p class="error"><%= equipError %></p><% } %>
<p class="hint">
  Serial numbers recorded per Fire Unit/Team. A Platoon 1 slot and its Platoon 2 counterpart
  (e.g. Fire Unit 1 and Fire Unit 4) are issued the same equipment — copy one's list into the
  other instead of retyping it, then remove (&times;) whichever few items are actually different
  for that unit.
</p>
<div class="outfield-board" data-group="<%= group %>">
  <% equipmentBoard.platoons.forEach(platoon => { %>
    <h2><%= platoon.name %></h2>
    <div class="outfield-platoon">
      <% platoon.sections.forEach(section => { %>
        <div class="outfield-section-card">
          <h4><%= section.name %></h4>
          <table class="attendance-table">
            <thead><tr><th>Item</th><th>Serial No.</th><% if (canEdit) { %><th></th><% } %></tr></thead>
            <tbody>
              <% section.items.forEach(item => { %>
              <tr>
                <td data-label="Item"><%= item.item_name %></td>
                <td data-label="Serial No."><%= item.serial_number %></td>
                <% if (canEdit) { %>
                <td>
                  <form method="post" action="/outfield/equipment/<%= item.id %>/remove" class="inline">
                    <input type="hidden" name="group" value="<%= group %>" />
                    <button type="submit" class="link-btn" title="Remove">&times;</button>
                  </form>
                </td>
                <% } %>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% if (section.items.length === 0) { %><p class="empty">No equipment recorded yet.</p><% } %>
          <% if (canEdit) { %>
          <form method="post" action="/outfield/equipment/add" class="inline">
            <input type="hidden" name="group" value="<%= group %>" />
            <input type="hidden" name="sectionId" value="<%= section.id %>" />
            <input type="text" name="itemName" placeholder="Item (e.g. Radio Set)" required />
            <input type="text" name="serialNumber" placeholder="Serial no." required />
            <button type="submit">Add</button>
          </form>
          <% if (section.pairedSectionId) { %>
          <form method="post" action="/outfield/equipment/copy" class="inline" onsubmit="return confirm('Copy <%= section.pairedSectionName %>\'s equipment list into <%= section.name %>? This replaces <%= section.name %>\'s current list.');">
            <input type="hidden" name="group" value="<%= group %>" />
            <input type="hidden" name="fromSectionId" value="<%= section.pairedSectionId %>" />
            <input type="hidden" name="toSectionId" value="<%= section.id %>" />
            <button type="submit" class="link-btn">Copy from <%= section.pairedSectionName %></button>
          </form>
          <% } %>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% }) %>
</div>
<% } else { %>

<p class="hint">
  <% if (!board.hasStructure) { %>
    No platoon/section structure has been defined for <%= group %> yet — everyone eligible is
    listed below, ready for when one is added.
  <% } %>
  HQ and DVR are shown as a shared pool at the bottom of every group's board, since they're the
  natural source of spares/replacements regardless of which group you're organizing. Anyone marked
  <span class="outfield-off-tag">OFF</span> has an approved Off/MC on one of the configured outfield
  dates (set on the Roster page) — they stay visible but can't be dragged into a Fire Unit slot.
  <% if (canEdit) { %>
    Drag a card into a slot to assign them, or type a name below, click the match, then click a
    slot/pool to place them. Dropping/placing onto an occupied slot bounces the previous person
    back to their own group's pool. Rank and name shown together.
  <% } else { %>
    Read-only view — ask an admin or editor to make changes.
  <% } %>
</p>

<% if (group === 'PCP' && canEdit) { %>
<% if (pcpError) { %><p class="error"><%= pcpError %></p><% } %>
<p class="hint">
  PCP has no fixed slots, so there's nothing to drag — type a name from RBS, FP, or PSTAR, pick a
  platoon, and add them. This moves them out of wherever they currently sit (a Fire Unit slot,
  Standby, etc.) into PCP's pool for that platoon.
</p>
<div class="add-exception">
  <form method="post" action="/outfield/pcp/add" id="pcp-add-form">
    <div class="search-wrap">
      <label>Person (RBS/FP/PSTAR) <input type="text" id="pcp-search-input" placeholder="Type a name…" autocomplete="off" /></label>
      <input type="hidden" name="rosterId" id="pcp-selected-roster-id" />
      <div id="pcp-search-results" class="search-results"></div>
    </div>
    <label>Platoon
      <select name="platoon">
        <option value="Platoon 1">Platoon 1</option>
        <option value="Platoon 2">Platoon 2</option>
      </select>
    </label>
    <button type="submit">Add</button>
  </form>
</div>
<script>
  window.PCP_SOURCE_ROSTER = <%- JSON.stringify(pcpSourceRoster.map(p => ({ id: p.id, name: p.name, ref_id: p.ref_id || '' }))) %>;
</script>
<script src="/outfield-pcp.js"></script>
<% } %>

<% if (canEdit) { %>
<div class="add-exception">
  <label>Find someone on this board <input type="text" id="outfield-search-input" placeholder="Type a name…" autocomplete="off" /></label>
  <div id="outfield-search-results" class="search-results"></div>
</div>
<p id="outfield-selected-hint" class="banner-warn" style="display:none;"></p>
<% } %>

<div class="outfield-board" data-group="<%= group %>">
  <% board.platoons.forEach(platoon => { %>
    <h2><%= platoon.name %></h2>
    <% if (platoon.sections) { %>
    <div class="outfield-platoon">
      <% platoon.sections.forEach(section => { %>
        <div class="outfield-section-card">
          <h4><%= section.name %></h4>
          <% board.coreSlots.forEach(slot => { %>
            <div class="outfield-slot" data-section-id="<%= section.id %>" data-slot="<%= slot %>">
              <span class="slot-label"><%= slot %></span>
              <div class="outfield-dropzone outfield-dropzone-slot" data-section-id="<%= section.id %>" data-slot="<%= slot %>">
                <% if (section.slots[slot]) { %>
                  <%- include('partials/outfield-card', { p: section.slots[slot], canEdit }) %>
                <% } %>
              </div>
            </div>
          <% }) %>
          <% board.spareSlots.forEach(slot => { %>
            <div class="outfield-slot outfield-slot-spare" data-section-id="<%= section.id %>" data-slot="<%= slot %>">
              <span class="slot-label"><%= slot %></span>
              <div class="outfield-dropzone outfield-dropzone-slot" data-section-id="<%= section.id %>" data-slot="<%= slot %>">
                <% if (section.slots[slot]) { %>
                  <%- include('partials/outfield-card', { p: section.slots[slot], canEdit }) %>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="outfield-staging">
      <div class="outfield-pool">
        <h3><%= platoon.pool.name %> (<%= platoon.pool.people.length %>)</h3>
        <div class="outfield-dropzone" data-section-id="<%= platoon.pool.id %>" data-slot="">
          <% platoon.pool.people.forEach(p => { %>
            <%- include('partials/outfield-card', { p, canEdit }) %>
          <% }) %>
        </div>
      </div>
    </div>
    <% } %>
  <% }) %>

  <% if (board.ownUnassigned) { %>
    <div class="outfield-staging">
      <div class="outfield-pool">
        <h3><%= board.ownUnassigned.name %> (<%= board.ownUnassigned.people.length %>)</h3>
        <div class="outfield-dropzone" data-section-id="<%= board.ownUnassigned.id %>" data-slot="">
          <% board.ownUnassigned.people.forEach(p => { %>
            <%- include('partials/outfield-card', { p, canEdit }) %>
          <% }) %>
        </div>
      </div>
    </div>
  <% } %>

  <% if (board.standby) { %>
    <div class="outfield-staging">
      <div class="outfield-pool">
        <h3><%= board.standby.name %> (<%= board.standby.people.length %>)</h3>
        <div class="outfield-dropzone" data-section-id="<%= board.standby.id %>" data-slot="">
          <% board.standby.people.forEach(p => { %>
            <%- include('partials/outfield-card', { p, canEdit }) %>
          <% }) %>
        </div>
      </div>
    </div>
  <% } %>

  <h2>HQ / DVR (shared)</h2>
  <div class="outfield-staging">
    <div class="outfield-pool">
      <h3>HQ (<%= board.hq.people.length %>)</h3>
      <div class="outfield-dropzone" data-section-id="<%= board.hq.id %>" data-slot="">
        <% board.hq.people.forEach(p => { %>
          <%- include('partials/outfield-card', { p, canEdit }) %>
        <% }) %>
      </div>
    </div>
    <div class="outfield-pool">
      <h3>DVR (<%= board.dvr.people.length %>)</h3>
      <div class="outfield-dropzone" data-section-id="<%= board.dvr.id %>" data-slot="">
        <% board.dvr.people.forEach(p => { %>
          <%- include('partials/outfield-card', { p, canEdit }) %>
        <% }) %>
      </div>
    </div>
  </div>
</div>
<% } %>

<% if (group === 'Others') { %>
<h2>Vehicle Tagging</h2>
<p class="hint">
  Which driver(s)/vehicle commander(s) are tagged to which vehicle — separate from Outfield
  Designation's boards, so tagging someone here doesn't move them out of their Fire Unit/Driver
  slot elsewhere. A driver can only be tagged to one vehicle at a time (tagging them elsewhere
  moves them); a vehicle commander can be tagged to more than one. Not drag-and-drop on purpose —
  only add/remove through the form below.
  <a href="/outfield/vehicles/export">Export to Excel</a>
</p>
<% if (vehicleError) { %><p class="error"><%= vehicleError %></p><% } %>

<table class="attendance-table">
  <thead><tr><th>Vehicle Type</th><th>License Plate</th><th>Driver(s)</th><th>Vehicle Commander(s)</th><% if (canEdit) { %><th></th><% } %></tr></thead>
  <tbody>
    <% vehicleTags.forEach(v => { %>
    <tr>
      <td data-label="Vehicle Type"><%= v.vehicleType || '' %></td>
      <td data-label="License Plate"><%= v.licensePlate %></td>
      <td data-label="Driver(s)">
        <% v.drivers.forEach(d => { %>
          <span class="badge badge-leave"><%= d.ref_id || '' %> <%= d.name %></span>
          <% if (canEdit) { %>
          <form method="post" action="/outfield/vehicles/<%= v.id %>/remove-driver/<%= d.id %>" class="inline">
            <button type="submit" class="link-btn">Remove</button>
          </form>
          <% } %>
        <% }) %>
      </td>
      <td data-label="Vehicle Commander(s)">
        <% v.commanders.forEach(c => { %>
          <span class="badge badge-leave"><%= c.ref_id || '' %> <%= c.name %></span>
          <% if (canEdit) { %>
          <form method="post" action="/outfield/vehicles/<%= v.id %>/remove-commander/<%= c.id %>" class="inline">
            <button type="submit" class="link-btn">Remove</button>
          </form>
          <% } %>
        <% }) %>
      </td>
      <% if (canEdit) { %>
      <td>
        <form method="post" action="/outfield/vehicles/<%= v.id %>/remove" class="inline">
          <button type="submit" class="link-btn">Remove vehicle</button>
        </form>
      </td>
      <% } %>
    </tr>
    <% }) %>
  </tbody>
</table>
<% if (vehicleTags.length === 0) { %><p class="empty">No vehicles tagged yet.</p><% } %>

<% if (canEdit) { %>
<div class="add-exception">
  <form method="post" action="/outfield/vehicles/add" id="vehicle-add-form">
    <div class="search-wrap">
      <label>Person (RBS/FP/PSTAR/HQ/DVR) <input type="text" id="vehicle-search-input" placeholder="Type a name…" autocomplete="off" /></label>
      <input type="hidden" name="rosterId" id="vehicle-selected-roster-id" />
      <div id="vehicle-search-results" class="search-results"></div>
    </div>
    <label>Role
      <select name="role">
        <option value="driver">Driver</option>
        <option value="commander">Vehicle Commander</option>
      </select>
    </label>
    <label>Vehicle Type
      <input type="text" name="vehicleType" list="vehicle-type-options" placeholder="e.g. 5-Tonner" />
      <datalist id="vehicle-type-options">
        <% [...new Set(vehicleTags.map(v => v.vehicleType).filter(Boolean))].forEach(t => { %><option value="<%= t %>"></option><% }) %>
      </datalist>
    </label>
    <label>License Plate
      <input type="text" name="licensePlate" list="vehicle-plate-options" placeholder="e.g. SBA1234A" required />
      <datalist id="vehicle-plate-options">
        <% vehicleTags.forEach(v => { %><option value="<%= v.licensePlate %>"></option><% }) %>
      </datalist>
    </label>
    <button type="submit">Add</button>
  </form>
</div>
<script>
  window.VEHICLE_SOURCE_ROSTER = <%- JSON.stringify(vehicleSourceRoster.map(p => ({ id: p.id, name: p.name, ref_id: p.ref_id || '' }))) %>;
</script>
<script src="/outfield-vehicles.js"></script>
<% } %>
<% } %>

<% if (canEdit) { %>
<script src="/outfield.js"></script>
<% } %>
<% } %>
<%- include('partials/footer') %>
