<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'Attendance' %></title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
<% if (currentUser) { %>
  <header class="topbar">
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <div class="topbar-main">
      <div class="brand"><a href="/">Daily Attendance</a></div>
      <label for="nav-toggle" class="nav-toggle-btn" aria-label="Menu">&#9776;</label>
    </div>
    <div class="topbar-menu">
      <nav>
        <% if (currentUser.role === 'self') { %>
          <a href="/my-attendance">My Attendance</a>
        <% } else { %>
          <a href="/">Home</a>
          <a href="/attendance">Mark Attendance</a>
          <a href="/summary">Summary</a>
          <a href="/establishment">Battery Establishment</a>
          <a href="/outfield">Outfield Designation</a>
          <% if (currentUser.role === 'admin') { %>
            <a href="/approvals">Approvals</a>
            <a href="/roster">Roster</a>
            <a href="/users">Users</a>
          <% } %>
        <% } %>
      </nav>
      <div class="who">
        <span><%= currentUser.username %></span>
        <a href="/account">Change password</a>
        <form method="post" action="/logout" class="inline">
          <button type="submit" class="link-btn">Log out</button>
        </form>
      </div>
    </div>
  </header>
<% } %>
<main class="container">
