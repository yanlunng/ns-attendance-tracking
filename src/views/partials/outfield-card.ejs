<div class="outfield-card<%= p.isOffOutfield ? ' outfield-card-off' : '' %>" <%- canEdit ? 'data-draggable="1"' : '' %> data-person-id="<%= p.id %>" data-search-name="<%= p.name %>"><span class="outfield-card-name"><%= p.ref_id || '' %> <%= p.name %></span><% if (p.isOffOutfield) { %> <span class="outfield-off-tag">OFF</span><% } %><% if (canEdit) { %><button type="button" class="outfield-card-remove" data-person-id="<%= p.id %>" title="Return to Unassigned">&times;</button><% } %></div>
