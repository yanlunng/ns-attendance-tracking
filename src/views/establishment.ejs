<%- include('partials/header') %>
<div class="page-head">
  <h1>Battery Establishment</h1>
  <a href="/establishment/export" class="button-link">Export to Excel</a>
</div>

<% if (importError) { %><p class="error"><%= importError %></p><% } %>

<% if (canEdit) { %>
<details class="outfield-template-box">
  <summary>Import a battery designation file</summary>
  <p class="hint">
    Re-applies group designations from a previously exported file, matched by name + date of
    birth. Only fills in people whose group is still auto-detected (never overwrites someone
    who already has a manual designation set), and skips anyone no longer on the active roster.
    Useful when a new NR carries stale/wrong battery info for people who haven't actually changed
    battery — fixing that here first is what lets the Outfield Designation import find them again.
  </p>
  <form method="post" action="/establishment/import" enctype="multipart/form-data" class="inline">
    <input type="file" name="file" accept=".xlsx" required />
    <button type="submit">Import</button>
  </form>
</details>
<% } %>

<p class="hint">
  Grouping is auto-detected from each person's Sub Unit 1 on upload. Once
  <% if (canEdit) { %>you<% } else { %>an admin or editor<% } %>
  manually change someone's group here, future roster uploads won't overwrite it.
</p>

<div class="tab-bar">
  <% tabs.forEach(tab => { %>
    <a href="/establishment?group=<%= tab %>" class="tab <%= tab === activeTab ? 'tab-active' : '' %>">
      <%= tab === 'ALL' ? 'All' : tab === 'UNASSIGNED' ? 'Unassigned' : tab %> (<%= counts[tab] %>)
    </a>
  <% }) %>
</div>

<% if (roster.length === 0) { %>
  <p class="empty">Nobody in this group.</p>
<% } else { %>
<table class="attendance-table">
  <thead>
    <tr><th>Name</th><th>Rank/ID</th><th>Sub Unit 1</th><th>Group</th><% if (canEdit) { %><th></th><% } %></tr>
  </thead>
  <tbody>
    <% roster.forEach(person => { %>
    <tr>
      <td data-label="Name"><%= person.name %></td>
      <td data-label="Rank/ID"><%= person.ref_id || '' %></td>
      <td data-label="Sub Unit 1"><%= person.subunit1_raw || '' %></td>
      <td data-label="Group">
        <span class="badge badge-<%= person.group_code ? 'leave' : 'warn' %>"><%= person.group_code || 'Unassigned' %></span>
        <% if (person.group_source === 'manual') { %><span class="hint">(manual)</span><% } %>
      </td>
      <% if (canEdit) { %>
      <td>
        <form method="post" action="/establishment/<%= person.id %>/group">
          <input type="hidden" name="returnTab" value="<%= activeTab %>" />
          <select name="group" onchange="this.form.submit()">
            <option value="">Unassigned</option>
            <% groupCodes.forEach(code => { %>
              <option value="<%= code %>" <%= person.group_code === code ? 'selected' : '' %>><%= code %></option>
            <% }) %>
          </select>
        </form>
      </td>
      <% } %>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>
<%- include('partials/footer') %>
